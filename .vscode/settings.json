{
    "editor.formatOnSave": true,
    "[cpp]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[c]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },

    // clangd provides IntelliSense, clang-tidy warnings and formatting (.clang-format).
    // Turn off Microsoft C/C++'s IntelliSense so the two don't report duplicate/conflicting errors.
    "C_Cpp.intelliSenseEngine": "disabled",

    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build",
        "--clang-tidy",
        "--header-insertion=never"
    ]
}
