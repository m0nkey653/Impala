{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "unix",
            "hidden": true,
            "inherits": "base",
            "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        },
        {
            "name": "windows",
            "hidden": true,
            "inherits": "base",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
            "architecture": { "value": "x64", "strategy": "external" }
        },
        {
            "name": "clang-cl",
            "hidden": true,
            "inherits": "windows",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "CMAKE_LINKER_TYPE": "LLD"
            }
        },
        {
            "name": "msvc",
            "hidden": true,
            "inherits": "windows",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            }
        },

        { "name": "debug",   "displayName": "Debug",   "inherits": "unix", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
        { "name": "release", "displayName": "Release", "inherits": "unix", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },

        { "name": "clang-cl-debug",   "displayName": "Debug (clang-cl)",   "inherits": "clang-cl", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
        { "name": "clang-cl-release", "displayName": "Release (clang-cl)", "inherits": "clang-cl", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
        { "name": "msvc-debug",       "displayName": "Debug (MSVC)",       "inherits": "msvc",     "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
        { "name": "msvc-release",     "displayName": "Release (MSVC)",     "inherits": "msvc",     "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } }
    ],
    "buildPresets": [
        { "name": "debug",            "configurePreset": "debug" },
        { "name": "release",          "configurePreset": "release" },
        { "name": "clang-cl-debug",   "configurePreset": "clang-cl-debug" },
        { "name": "clang-cl-release", "configurePreset": "clang-cl-release" },
        { "name": "msvc-debug",       "configurePreset": "msvc-debug" },
        { "name": "msvc-release",     "configurePreset": "msvc-release" }
    ]
}
