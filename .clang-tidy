# Naming rules for Impala (see readability-identifier-naming docs).
# Only the naming check is enabled for now; add more checks to the list as wanted.
Checks: '-*,readability-identifier-naming'

# Only report problems in our own headers, never SDL's or the standard library's
HeaderFilterRegex: '.*/(impala-engine|games)/.*'

CheckOptions:
  # namespace impala
  - { key: readability-identifier-naming.NamespaceCase,            value: lower_case }

  # Types: GolfGame, Sprite, AppInfo
  - { key: readability-identifier-naming.ClassCase,                value: CamelCase }
  # Interfaces (any class with a pure virtual method): IGame, IAssetDatabase
  - { key: readability-identifier-naming.AbstractClassCase,        value: CamelCase }
  - { key: readability-identifier-naming.AbstractClassPrefix,      value: I }
  - { key: readability-identifier-naming.StructCase,               value: CamelCase }
  - { key: readability-identifier-naming.UnionCase,                value: CamelCase }
  - { key: readability-identifier-naming.EnumCase,                 value: CamelCase }
  - { key: readability-identifier-naming.TypeAliasCase,            value: CamelCase }
  - { key: readability-identifier-naming.TypedefCase,              value: CamelCase }
  - { key: readability-identifier-naming.TemplateParameterCase,    value: CamelCase }
  # C++20 concepts: Component, Drawable
  - { key: readability-identifier-naming.ConceptCase,              value: CamelCase }

  # Functions and methods: Init(), CreateGame()
  - { key: readability-identifier-naming.FunctionCase,             value: CamelCase }
  - { key: readability-identifier-naming.MethodCase,               value: CamelCase }
  # SDL's callback entry points and main() have fixed names we can't change
  - { key: readability-identifier-naming.FunctionIgnoredRegexp,    value: '^(main|SDL_App(Init|Iterate|Event|Quit))$' }

  # Locals, parameters, other variables: deltaTime, windowWidth
  - { key: readability-identifier-naming.VariableCase,             value: camelBack }
  - { key: readability-identifier-naming.ParameterCase,            value: camelBack }
  - { key: readability-identifier-naming.LocalVariableCase,        value: camelBack }

  # Private/protected members: _renderer, _lastTicks
  - { key: readability-identifier-naming.PrivateMemberCase,        value: camelBack }
  - { key: readability-identifier-naming.PrivateMemberPrefix,      value: _ }
  - { key: readability-identifier-naming.ProtectedMemberCase,      value: camelBack }
  - { key: readability-identifier-naming.ProtectedMemberPrefix,    value: _ }
  # Public fields of plain structs (AppInfo::title) get no prefix
  - { key: readability-identifier-naming.PublicMemberCase,         value: camelBack }

  # enum class Key { Space, Escape }
  - { key: readability-identifier-naming.EnumConstantCase,         value: CamelCase }
  - { key: readability-identifier-naming.ScopedEnumConstantCase,   value: CamelCase }

  # Macros: IMPALA_ASSERT, GOLF_VERSION
  - { key: readability-identifier-naming.MacroDefinitionCase,      value: UPPER_CASE }
